# denops MCP server, supervised.
#
# The supervisor (scripts/live-supervisor.sh) owns which commit runs: it checks out
# data/desired-commit, requires /health, soaks, and auto-reverts to data/last-good
# when a new commit fails. systemd only keeps the supervisor alive.
#
# Install:
#   sudo cp deploy/denops.service /etc/systemd/system/denops.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now denops
[Unit]
Description=denops MCP server (supervised)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freebox
Group=freebox
WorkingDirectory=/home/freebox/denops
ExecStart=/home/freebox/denops/scripts/live-supervisor.sh
Restart=always
RestartSec=3
# KillMode=control-group: the supervisor starts the server with setsid and signals
# the process group, but this also reaps anything it missed.
KillMode=control-group
TimeoutStopSec=25
Environment=DENOPS_SOAK_SEC=60
Environment=DENOPS_HEALTH_URL=http://127.0.0.1:3100/health
# Modest hardening; the service needs write access to its own tree (git checkout)
# and to ~/.cache/deno, so filesystem protection stays off.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
