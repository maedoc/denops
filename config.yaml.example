# Copy to config.yaml. config.yaml is gitignored.
server:
  host: 127.0.0.1
  port: 3100
  # Optional static bearer token required on the /mcp endpoint (Authorization: Bearer <token>).
  # If set, also required in secrets.json as `serverToken`.
  # token: ""

budgets:
  wallClockMs: 120000
  maxOpsPerRun: 200
  maxOpResultBytes: 1048576
  maxOpArgsBytes: 26214400
  maxLogBytes: 10485760

connectors:
  debug:
    enabled: true
  gitlab:
    enabled: false
    origin: https://gitlab.ebrains.eu
    apiPath: /api/v4
  mistral:
    enabled: false
    origin: https://api.mistral.ai
    apiPath: /v1
    startup:
      # Verify API key with a cheap read-only call at startup. Fail fast if invalid.
      verifyKey: true
      # Check (read-only) that a Vibe/Studio MCP connector pointing at this server is
      # registered. Experimental beta API; failure is reported, not fatal, unless
      # strict is true. Requires an API key with connector scope.
      checkVibeConnector:
        enabled: false
        name: denops          # connector name to look for
        expectServerUrl: ""   # optional: expected MCP server URL, e.g. http://127.0.0.1:3100/mcp
        strict: false
  imap:
    enabled: false
    accounts: []
    # - id: work
    #   host: imap.example.org
    #   port: 993
    #   tls: true
    #   draftsMailbox: Drafts
    #   passwordSecret: mail.work.password   # key into secrets.json

startup:
  # full: validate secrets and reachability of all enabled connectors, fail fast on error.
  # none: skip validation (dev only).
  validate: full
