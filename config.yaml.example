# Copy to config.yaml. config.yaml is gitignored.
server:
  host: 127.0.0.1
  port: 3100
  # Static bearer token required on the /mcp endpoint (Authorization: Bearer <token>).
  # Also read from secrets.json `serverToken`, or from `tokenFile` (e.g. a mounted secret).
  # Binding to a non-loopback host without a token is refused at startup.
  # token: ""
  # tokenFile: /run/secrets/denops_token
  # requireToken: true        # hard-fail startup when no token is configured
  # maxBodyBytes: 4194304     # request body cap
  # trustedProxy: 127.0.0.1   # behind Caddy on the same host: trust X-Forwarded-For from here
  # Static-client OAuth for MCP clients that only speak OAuth (client_credentials).
  # The client secret IS the bearer token above; /oauth/token returns it as the
  # access token, so /mcp keeps validating the same value.
  # oauth:
  #   clientId: mistral
  #   publicUrl: https://mcp.example.com  # default: derived from the request Host
  #   ttlSec: 3600                        # advisory expires_in
  #   # redirect hosts accepted for browser (authorization_code) flows with the
  #   # pre-registered client id; defaults cover Google/Anthropic/OpenAI
  #   # redirecters plus loopback. The consent page's token check is the real gate.
  #   redirectHosts: [oauth-redirect.googleusercontent.com, localhost, 127.0.0.1]
  # skipLoopbackBan: true     # loopback peers are never auto-banned
  # ban:                      # fail2ban-style brute-force protection
  #   file: data/bans         # persist auto-bans; truncate the file to reset live bans
  #   blacklistFile: blacklist.txt   # one CIDR or IP per line, '#' comments, hot-reloaded
  #   whitelistFile: whitelist.txt   # exempts from blacklist AND auto-bans
  #   maxFailures: 5          # failures within windowMs -> ban for durationMs
  #   windowMs: 600000
  #   durationMs: 86400000

budgets:
  wallClockMs: 120000
  maxOpsPerRun: 200
  maxOpResultBytes: 1048576
  maxOpArgsBytes: 26214400
  maxLogBytes: 10485760

connectors:
  debug:
    enabled: true
  gitlab:
    enabled: false
    origin: https://gitlab.ebrains.eu
    apiPath: /api/v4
  mistral:
    enabled: false
    origin: https://api.mistral.ai
    apiPath: /v1
    startup:
      # Verify API key with a cheap read-only call at startup. Fail fast if invalid.
      verifyKey: true
      # Check (read-only) that a Vibe/Studio MCP connector pointing at this server is
      # registered. Experimental beta API; failure is reported, not fatal, unless
      # strict is true. Requires an API key with connector scope.
      checkVibeConnector:
        enabled: false
        name: denops          # connector name to look for
        expectServerUrl: ""   # optional: expected MCP server URL, e.g. http://127.0.0.1:3100/mcp
        strict: false
  fs:
    enabled: false
    # Named roots the fs.* ops can address. The model refers to roots by name;
    # absolute paths are never accepted from the model.
    # First fs.* op on a root is approval-tier; approving it grants the root
    # (persisted in data/root_grants.json) and later fs.* ops on that root run
    # open. Revoke via the `grants` tool.
    roots: []
    # - name: myrepo        # referenced as root: "myrepo"
    #   path: /srv/repos/myrepo
    #   write: true         # allow fs.write / fs.edit / fs.editRegex
    #   exec: true          # allow fs.exec (sh -c, cwd=root, scrubbed env)
    # maxFileSize: 2097152
    # maxOutput: 262144
    # execTimeoutSec: 120
    # maxConcurrentExec: 2
  imap:
    enabled: false
    accounts: []
    # - id: work              # ops take { account: "work", ... }
    #   host: imap.example.org
    #   port: 993
    #   tls: true
    #   user: me@example.org
    #   # auto = follow the folder's \\Drafts special-use flag (names differ per
    #   # server and locale: Drafts, Brouillons, …); set a path to pin it
    #   draftsMailbox: auto
    #   messageIdDomain: example.org  # for the Message-IDs the server mints
    #   socketTimeoutMs: 300000  # drop + reconnect after this much socket inactivity (default 5 min)
    #   # password lives in secrets.json as mail.work.password

startup:
  # full: validate secrets and reachability of all enabled connectors, fail fast on error.
  # none: skip validation (dev only).
  validate: full

# --- fetching the web (optional) ---------------------------------------------
#  web: GET one http(s) document into a run (text, or raw html). allowedHosts is the
#       whole security boundary: it narrows --allow-net AND gates the op, and every
#       resolved address must be public (SSRF guard), so never list a LAN host.
#
# connectors:
#   web:
#     enabled: true
#     allowedHosts: [arxiv.org, export.arxiv.org, "*.githubusercontent.com"]
#     # resolvers for the SSRF check: Deno.resolveDns needs net access to the
#     # resolver itself, and derivePermissions adds these to --allow-net
#     dnsServers: ["1.1.1.1:53", "9.9.9.9:53"]
#     maxBytes: 262144
#     timeoutMs: 20000
#     userAgent: "denops/0.2 (+https://example.org)"

# --- agent-assisted development (optional) -----------------------------------
#  dev:    work on code without a shell — a project's declared argv tables
#  deploy: record deploy intent for scripts/live-supervisor.sh (restart, health
#          probe, soak, auto-revert live in the supervisor, not in the server)
#
# connectors:
#   dev:
#     enabled: true
#     timeoutMs: 180000
#     # extra hosts dev.try's child may reach. Its network envelope comes from THIS
#     # file (operator-owned) plus this list, never from the dev checkout's own
#     # config.yaml — an agent can edit that one, and a redirected origin would leak
#     # the credential the op carries.
#     tryExtraHosts: []
#     roots:
#       - name: denops-dev                 # worktree the agent owns
#         path: /home/freebox/denops-dev
#         checkTask: check                 # task that must pass for HEAD before dev.try
#         tasks:                           # argv only, never a shell
#           check:
#             - deno
#             - check
#             - src/server.ts
#             - tests/
#           test:
#             - deno
#             - task
#             - test
#           fmt: [deno, fmt, src, tests, scripts]
#   deploy:
#     enabled: true
#     liveDir: /home/freebox/denops        # live checkout, detached at desired-commit
#     devBranch: agent/dev
#     devRoot: denops-dev
